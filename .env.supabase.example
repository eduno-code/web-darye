# Credenciales del CLI de Supabase — PLANTILLA
#
# Copia este archivo a ".env.supabase" (ignorado por git) y rellena los dos
# valores. Nunca se imprimen en pantalla: los comandos los leen del archivo,
# así que no acaban en el historial de la terminal ni en la conversación.

# Token personal: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# La contraseña de la base de datos que guardaste al crear el proyecto.
SUPABASE_DB_PASSWORD=...
